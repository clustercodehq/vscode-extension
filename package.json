{
  "name": "clustercode-vscode-extension",
  "displayName": "ClusterCode",
  "description": "Run and monitor ClusterCode AI coding agents from a tab inside VS Code.",
  "version": "0.1.0",
  "publisher": "clustercode",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/clustercodehq/vscode-extension"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "clustercode",
    "ai",
    "agents",
    "devbox",
    "coding-agent"
  ],
  "activationEvents": [
    "onCommand:clustercode.open",
    "onCommand:clustercode.reload",
    "onCommand:clustercode.pairDevice",
    "onCommand:clustercode.signOut"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Signs in to ClusterCode and opens the console webview (a remote orchestrator page). It does not read, execute, or trust any workspace files, so it runs in untrusted workspaces."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "clustercode.open",
        "title": "ClusterCode: Open",
        "icon": "$(server)"
      },
      {
        "command": "clustercode.reload",
        "title": "ClusterCode: Reload",
        "icon": "$(refresh)"
      },
      {
        "command": "clustercode.pairDevice",
        "title": "ClusterCode: Pair Device",
        "icon": "$(key)"
      },
      {
        "command": "clustercode.signOut",
        "title": "ClusterCode: Sign Out",
        "icon": "$(sign-out)"
      }
    ],
    "configuration": {
      "title": "ClusterCode",
      "properties": {
        "clustercode.extraFrameOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "https://*.clerk.accounts.dev",
            "https://*.clerk.com"
          ],
          "description": "Additional origins the embedded UI is permitted to load in a frame (added to the webview's CSP frame-src). Only needed if an allowed page fails to load."
        }
      }
    },
    "keybindings": []
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "package": "npm run build && node scripts/package-ext.mjs",
    "install-ext": "npm run package && node scripts/install-ext.mjs",
    "uninstall-ext": "code --uninstall-extension clustercode.clustercode-vscode-extension",
    "test": "tsx --test tests/unit/url-guard.spec.ts tests/unit/orchestrator-url.spec.ts tests/unit/deviceFlow.spec.ts tests/unit/openFlow.spec.ts tests/unit/devicePairingProvider.spec.ts tests/e2e/extension/activation.spec.ts"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.20.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
